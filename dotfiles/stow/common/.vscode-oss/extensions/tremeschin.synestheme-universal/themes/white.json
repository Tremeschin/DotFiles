  "tokenColors": [
    {
      "settings": {
        "foreground": "#4c4f69"
      }
    },
    {
      "scope": [
        "meta.embedded",
        "source.groovy.embedded"
      ],
      "settings": {
        "foreground": "#4c4f69"
      }
    },
    {
      "name": "Comment",
      "scope": "comment",
      "settings": {
        "foreground": "#7c7f93"
      }
    },
    {
      "name": "String",
      "scope": "string",
      "settings": {
        "foreground": "#40a02b"
      }
    },
    {
      "name": "Template Definition",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#d20f39"
      }
    },
    {
      "name": "Reset JavaScript string interpolation expression",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#4c4f69"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#8839ef"
      }
    },
    {
      "name": "Built-in constant",
      "scope": "constant.language",
      "settings": {
        "foreground": "#8839ef"
      }
    },
    {
      "name": "User-defined constant",
      "scope": "constant.character, constant.other",
      "settings": {
        "foreground": "#8839ef"
      }
    },
    {
      "name": "ALL_CAPS constants (purple)",
      "scope": "variable.other.constant",
      "settings": {
        "foreground": "#8839ef",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": "variable",
      "settings": {
        "fontStyle": "",
        "foreground": "#4c4f69"
      }
    },
    {
      "name": "Properties (faded)",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "variable.object.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "fontStyle": "",
        "foreground": "#8c8fa1"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword",
      "settings": {
        "foreground": "#e64553"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "storage.type.function.lambda.python"
      ],
      "settings": {
        "foreground": "#7c7f93"
      }
    },
    {
      "name": "Storage",
      "scope": "storage",
      "settings": {
        "fontStyle": "",
        "foreground": "#e64553"
      }
    },
    {
      "name": "Storage type",
      "scope": "storage.type",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#e64553"
      }
    },
    {
      "name": "Class name",
      "scope": "entity.name.type, entity.name.class",
      "settings": {
        "fontStyle": "",
        "foreground": "#c7a41a"
      }
    },
    {
      "name": "Class name (Python)",
      "scope": [
        "entity.name.type.class.python"
      ],
      "settings": {
        "foreground": "#4c4f69",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Inherited class",
      "scope": "entity.other.inherited-class",
      "settings": {
        "fontStyle": "italic",
        "foreground": "#c7a41a"
      }
    },
    {
      "name": "Function name",
      "scope": "entity.name.function",
      "settings": {
        "fontStyle": "",
        "foreground": "#7ea12b"
      }
    },
    {
      "name": "Function argument",
