{
  "name": "synestheme",
  "version": "1.0.0",
  "displayName": "Synestheme",
  "description": "A Synesthesia inspired theme with strong and opinionated syntax colors (vscode-monokai-night fork)",
  "publisher": "Tremeschin",
  "repository": "github:Tremeschin/Synestheme",
  "engines": {
    "vscode": "*"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "uiTheme": "vs-dark",
        "label": "Synestheme Dark",
        "path": "./themes/dark.json"
      },
      {
        "uiTheme": "vs",
        "label": "Synestheme White",
        "path": "./themes/white.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "synestheme.injection.python",
        "path": "./syntax/python.json",
        "injectTo": [
          "source.python"
        ]
      }
    ]
  }
}
