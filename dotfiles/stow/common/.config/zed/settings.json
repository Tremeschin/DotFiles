{
  "agent": {
    "inline_assistant_model": {
      "provider": "ollama",
      "model": "qwen3.5:9b",
      "enable_thinking": false,
    },
    "favorite_models": [
      {
        "provider": "ollama",
        "model": "gemma4:e2b",
        "enable_thinking": true,
      },
      {
        "provider": "ollama",
        "model": "gemma4:e4b",
        "enable_thinking": true,
      },
      {
        "provider": "ollama",
        "model": "gemma4:12b",
        "enable_thinking": true,
      },
      {
        "provider": "ollama",
        "model": "qwen3.5:9b",
        "enable_thinking": true,
      },
      {
        "provider": "ollama",
        "model": "qwen3.6:35b-a3b",
        "enable_thinking": true,
      },
    ],
    "flexible": true,
    "button": true,
    "default_model": {
      "enable_thinking": true,
      "model": "gemma4:12b",
      "provider": "ollama",
    },
    "default_profile": "ask",
    "dock": "right",
    "enable_feedback": false,
  },
  "agent_buffer_font_size": 20,
  "auto_update": false,
  "base_keymap": "VSCode",
  "buffer_font_family": "Comic Mono",
  "buffer_font_size": 28,
  "buffer_font_weight": 900,
  "buffer_line_height": "standard",
  "cli_default_open_behavior": "existing_window",
  "collaboration_panel": {
    "button": false,
  },
  "debugger": {
    "button": false,
  },
  "diagnostics": {
    "button": false,
  },
  "disable_ai": false,
  "edit_predictions": {
    "allow_data_collection": "no",
    "mode": "subtle",
    "ollama": {
      "max_output_tokens": 32,
      "model": "qwen3.5:9b",
      "prompt_format": "qwen",
    },
    "provider": "ollama",
  },
  "extend_comment_on_newline": false,
  "file_scan_exclusions": [".stfolder", ".git", ".venv", ".stignore"],
  "format_on_save": "on",
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "git_commit_buffer_font_size": 20,
  "git_panel": {
    "group_by": "staging",
    "tree_view": true,
  },
  "hover_popover_delay": 200,
  "hover_popover_hiding_delay": 0,
  "icon_theme": "JetBrains New UI Icons (Dark)",
  "indent_guides": {
    "active_line_width": 3,
    "coloring": "fixed",
  },
  "inline_code_actions": false,
  "language_models": {
    "ollama": {
      "context_window": 65536,

      // Fixme: Global keep_alive
      "available_models": [
        {
          "name": "gemma4:e2b",
          "max_tokens": 65536,
          "keep_alive": "5m",
          "supports_thinking": true,
          "supports_tools": true,
        },
        {
          "name": "gemma4:e4b",
          "max_tokens": 65536,
          "keep_alive": "5m",
          "supports_thinking": true,
          "supports_tools": true,
        },
        {
          "name": "gemma4:12b",
          "max_tokens": 65536,
          "keep_alive": "5m",
          "supports_thinking": true,
          "supports_tools": true,
        },
        {
          "name": "qwen3.5:9b",
          "max_tokens": 65536,
          "keep_alive": "5m",
          "supports_thinking": true,
          "supports_tools": true,
        },
        {
          "name": "qwen3.6:35b-a3b",
          "max_tokens": 65536,
          "keep_alive": "5m",
          "supports_thinking": true,
          "supports_tools": true,
        },
      ],
    },
  },
  "languages": {
    "Markdown": {
      "format_on_save": "off",
    },
    "Python": {
      "code_actions_on_format": {
        "source.fixAll.ruff": true,
        "source.organizeImports": true,
      },
      "language_servers": ["basedpyright", "ruff", "ty"],
    },
  },
  "line_ending": "enforce_lf",
  "lsp": {
    "tinymist": {
      "settings": {
        "exportPdf": "onSave",
        "outputPath": "/tmp/$name",
        "formatterMode": "typstyle",
      },
    },
  },
  "minimap": {
    "display_in": "all_editors",
    "show": "always",
    "thumb": "always",
    "thumb_border": "none",
  },
  "mouse_wheel_zoom": true,
  "outline_panel": {
    "button": false,
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "bold_folder_labels": true,
    "dock": "left",
    "entry_spacing": "standard",
    "git_status": false,
    "hide_root": false,
    "indent_size": 20,
    "sticky_scroll": false,
  },
  "restore_on_startup": "last_workspace",
  "scroll_sensitivity": 2,
  "search": {
    "include_ignored": true,
  },
  "semantic_tokens": "off",
  "show_wrap_guides": true,
  "status_bar": {
    "cursor_position_button": false,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "text_rendering_mode": "subpixel",
  "theme": "Synestheme",
  "title_bar": {
    "button_layout": "standard",
    "show_sign_in": false,
  },
  "toolbar": {
    "agent_review": true,
    "breadcrumbs": true,
    "code_actions": true,
    "quick_actions": true,
    "selections_menu": true,
  },
  "ui_font_size": 28,
  "wrap_guides": [100, 80],
}
