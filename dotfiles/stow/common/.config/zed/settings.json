{
  "auto_update": false,
  "base_keymap": "VSCode",
  "buffer_font_family": "Comic Mono",
  "buffer_font_size": 24,
  "buffer_font_weight": 900,
  "buffer_line_height": "standard",
  "cli_default_open_behavior": "existing_window",
  "collaboration_panel": {
    "button": false,
  },
  "debugger": {
    "button": false,
  },
  "diagnostics": {
    "button": true,
  },
  "disable_ai": false,
  "extend_comment_on_newline": false,
  "file_scan_exclusions": [
    "**/.git",
    "**/.stfolder",
    "**/.stignore",
    "**/.venv",
    "**/py.typed",
    // "**/site",
  ],
  "format_on_save": "on",
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "git_commit_buffer_font_size": 20,
  "git_panel": {
    "group_by": "staging",
    "tree_view": true,
  },
  "hover_popover_delay": 200,
  "hover_popover_hiding_delay": 0,
  "icon_theme": "JetBrains New UI Icons (Dark)",
  "indent_guides": {
    "active_line_width": 3,
    "coloring": "fixed",
  },
  "inline_code_actions": false,
  "languages": {
    "Markdown": {
      "format_on_save": "off",
    },
    "Python": {
      "code_actions_on_format": {
        "source.fixAll.ruff": true,
        "source.organizeImports": true,
      },
      "language_servers": ["!basedpyright", "ruff", "ty"],
    },
    "Rust": {
      "format_on_save": "off",
    },
  },
  "minimap": {
    "display_in": "all_editors",
    "show": "always",
    "thumb": "always",
    "thumb_border": "none",
  },
  "mouse_wheel_zoom": true,
  "outline_panel": {
    "button": false,
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "bold_folder_labels": true,
    "dock": "left",
    "entry_spacing": "standard",
    "git_status": false,
    "hide_root": false,
    "indent_size": 20,
    "sticky_scroll": false,
  },
  "restore_on_startup": "last_workspace",
  "scroll_sensitivity": 2,
  "search": {
    "include_ignored": true,
  },
  "semantic_tokens": "off",
  "show_wrap_guides": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "text_rendering_mode": "subpixel",
  "theme": "Synestheme",
  "title_bar": {
    "button_layout": "standard",
    "show_sign_in": false,
  },
  "toolbar": {
    "code_actions": true,
  },
  "ui_font_size": 24,
  "wrap_guides": [100, 80],
}
