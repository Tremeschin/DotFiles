{
  "agent": {
    "button": false,
    "sidebar_side": "right",
  },
  "auto_update": false,
  "base_keymap": "VSCode",
  "buffer_font_family": "Comic Mono",
  "buffer_font_size": 28,
  "buffer_font_weight": 900,
  "buffer_line_height": "standard",
  "collaboration_panel": {
    "button": false,
  },
  "debugger": {
    "button": false,
  },
  "diagnostics": {
    "button": false,
  },
  "disable_ai": false,
  "edit_predictions": {
    "allow_data_collection": "no",
    "mode": "eager",
    "ollama": {
      "max_output_tokens": 32,
      "model": "ornith:9b",
    },
    "provider": "ollama",
  },
  "extend_comment_on_newline": false,
  "format_on_save": "on",
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "git_panel": {
    "group_by": "staging",
    "tree_view": true,
  },
  "hover_popover_delay": 200,
  "hover_popover_hiding_delay": 0,
  "icon_theme": "JetBrains New UI Icons (Dark)",
  "indent_guides": {
    "active_line_width": 3,
    "coloring": "fixed",
  },
  "inline_code_actions": false,
  "language_models": {
    "ollama": {
      "context_window": 8192,
    },
  },
  "languages": {
    "Python": {
      "code_actions_on_format": {
        "source.fixAll.ruff": true,
        "source.organizeImports": true,
      },
      "language_servers": ["basedpyright", "ruff", "ty"],
    },
  },
  "line_ending": "enforce_lf",
  "minimap": {
    "display_in": "all_editors",
    "show": "always",
    "thumb": "always",
    "thumb_border": "none",
  },
  "mouse_wheel_zoom": true,
  "outline_panel": {
    "button": false,
  },
  "project_panel": {
    "auto_fold_dirs": false,
    "bold_folder_labels": true,
    "dock": "left",
    "entry_spacing": "standard",
    "git_status": false,
    "hide_root": true,
    "indent_size": 20,
    "sticky_scroll": false,
  },
  "restore_on_startup": "last_workspace",
  "scroll_sensitivity": 2,
  "search": {
    "include_ignored": true,
  },
  "semantic_tokens": "off",
  "show_wrap_guides": true,
  "status_bar": {
    "cursor_position_button": false,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "terminal": {
    "button": false,
  },
  "theme": "Synestheme",
  "title_bar": {
    "button_layout": "standard",
    "show_sign_in": false,
  },
  "toolbar": {
    "agent_review": true,
    "breadcrumbs": true,
    "code_actions": true,
    "quick_actions": true,
    "selections_menu": true,
  },
  "ui_font_size": 28,
  "wrap_guides": [100, 80],
}
