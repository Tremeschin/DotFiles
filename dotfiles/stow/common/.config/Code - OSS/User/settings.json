{
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "chat.titleBar.signIn.enabled": false,
    "editor.autoClosingBrackets": "beforeWhitespace",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.fontFamily": "Comic Mono",
    "editor.fontLigatures": false,
    "editor.fontWeight": "bold",
    "editor.inlayHints.enabled": "offUnlessPressed",
    "editor.minimap.renderCharacters": false,
    "editor.mouseWheelScrollSensitivity": 6,
    "editor.mouseWheelZoom": true,
    "editor.rulers": [80, 100],
    "editor.smoothScrolling": true,
    "editor.stickyScroll.enabled": true,
    "explorer.autoReveal": false,
    "explorer.compactFolders": false,
    "explorer.confirmDelete": false,
    "explorer.decorations.colors": false,
    "extensions.autoUpdate": "off",
    "files.trimTrailingWhitespace": true,
    "files.trimFinalNewlines": true,
    "files.insertFinalNewline": true,
    "git.confirmSync": false,
    "git.enableCommitSigning": true,
    "rust-analyzer.cargo.features": "all",
    "rust-analyzer.checkOnSave": false,
    "rust-analyzer.lens.implementations.enable": false,
    "scm.repositories.selectionMode": "multiple",
    "telemetry.telemetryLevel": "off",
    "tinymist.preview.scrollSync": "never",
    "tinymist.typingContinueCommentsOnNewline": false,
    "update.mode": "none",
    "window.commandCenter": false,
    "window.title": " ",
    "window.zoomLevel": 2,
    "workbench.colorTheme": "Synestheme Dark",
    "workbench.editor.useModal": "off",
    "workbench.enableExperiments": false,
    "workbench.iconTheme": "monospace",
    "workbench.list.smoothScrolling": true,
    "workbench.navigationControl.enabled": false,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.startupEditor": "none",
    "workbench.tree.indent": 16,
    "workbench.tree.renderIndentGuides": "always",
    "[python]": {
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.fixAll.convertImportFormat": "always",
            "source.organizeImports": "explicit"
        },
        "editor.formatOnSave": true
    },
}
